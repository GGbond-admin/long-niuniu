# 服务
PORT=8080
NODE_ENV=development

# 数据库
DATABASE_URL="postgresql://niuniu:niuniu_dev_pw@localhost:5432/niuniu?schema=public"
REDIS_URL="redis://localhost:6380"

# 管理后台 JWT
ADMIN_JWT_SECRET="replace-with-a-long-random-secret"
SENSITIVE_DATA_KEY="replace-with-an-independent-32-character-random-key"
SEED_ADMIN_USERNAME="admin"
# 首次启动空库时必填；不要使用 admin123 等公开弱口令
SEED_ADMIN_PASSWORD=""

# Web 安全（逗号分隔）
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
TRUST_PROXY="false"
# 开启 TRUST_PROXY 时必填，只信任实际反向代理；示例：127.0.0.1/32,10.0.0.0/8
TRUSTED_PROXY_CIDRS=""
PUBLIC_API_URL="http://localhost:8080"
UPLOAD_DIR="./uploads"
# TNG Money Packet 允许域名（逗号分隔）。生产未配置时默认 links.tngdigital.com.my
# 也可写 apex：tngdigital.com.my（会自动接受其子域）
TNG_PACKET_HOSTS="links.tngdigital.com.my"

# 默认 Telegram Bot（可在后台添加更多）
DEFAULT_BOT_TOKEN=""
DEFAULT_BOT_USERNAME=""

# Mini App 地址（用于菜单按钮）
MINIAPP_URL="https://example.com"
